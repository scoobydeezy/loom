.top-bar {
    height: 48px;
    background-color: rgba(10, 10, 10, 0.85);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
}

.top-bar-inner {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.mode-toggle {
    height: 32px;
    min-width: 80px;
    background-color: rgba(80, 130, 220, 0.85);
    color: rgba(255, 255, 255, 0.95);
    border-width: 0;
    border-radius: 6px;
    -unity-font-style: bold;
}

.mode-toggle:hover {
    background-color: rgba(100, 150, 240, 0.95);
}

.breadcrumb {
    flex-direction: row;
    align-items: center;
}

.breadcrumb Label {
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
}

.status-bar {
    flex-direction: row;
    align-items: center;
}
