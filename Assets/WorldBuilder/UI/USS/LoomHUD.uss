.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

.canvas-region {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.spacer {
    flex-grow: 1;
}

.separator {
    width: 1px;
    height: 24px;
    background-color: rgba(255, 255, 255, 0.15);
    margin-left: 12px;
    margin-right: 12px;
}
